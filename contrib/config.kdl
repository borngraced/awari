// ~/.config/awari/config.kdl
// Unknown keys are ignored. No exec / no shell interpolation.
// Every block and token is optional; omit anything you don't want to change.

// ── Theme ─────────────────────────────────────────────────────────────
// Pick a built-in palette by name (case-insensitive), then override tokens:
//   awari (default) · ash · ember · verdant · paper · mono
//   nord · tokyonight · catppuccin · gruvbox
// Colors accept #RGB, #RRGGBB, or #RRGGBBAA — no url() or named CSS colors.
theme {
    name "awari"               // preset; omit to define every color by hand

    // font "Inter"             // default is the bundled JetBrains Mono; any fontdb family
    //                         // override; "default"/"" = GPUI system UI font
    // font-size 14             // px; clamped to 8..=64

    // Token aliases also accepted in config:
    //   select        → accent-dim
    //   hover / surface → raise
    //   fg            → text
    //   muted         → text-dim
    //   faint         → text-faint
    accent      "#cba6f7"
    accent-dim  "#cba6f733"
    bg          "#11111b"
    panel       "#1e1e2e"
    raise       "#313244"
    border      "#45475a"
    text        "#cdd6f4"
    text-dim    "#a6adc8"
    text-faint  "#9399b2"
    scrim       "#08080ce6"
}

// ── Files ────────────────────────────────────────────────────────────
files {
    // roots "~/Documents" "~/Downloads" "~/code"
    // Empty or omitted = existing XDG user dirs (Desktop, Documents, …).
    // `/` is ignored; `~` expands to $HOME. Never index all of `/`.
    index_lockfiles false     // show Cargo.lock, package-lock.json, *.lock, …
    regex           false     // treat file queries as regex (the `r:` prefix forces it per-query)
    max-results     50        // max file rows shown
}

// ── fff ──────────────────────────────────────────────────────────────
// Options passed to the fff-search file indexers. The search root is always
// `files.roots`, and home scanning is automatic when a root is `$HOME`, so
// those two are not configurable.
fff {
    watch true             // background file watcher keeps the index warm
    fs-root-scanning true  // allow indexing the filesystem root
    mmap-cache false       // pre-populate mmap caches for top-frecency files
    content-indexing false // build a content index for content-aware filtering
    follow-symlinks false  // index through symbolic links
}

// ── Sources ───────────────────────────────────────────────────────────
// Hide a backend without recompiling. Apps are always indexed and cannot be
// turned off.
sources {
    windows true
    files   true
}

// ── Motion ───────────────────────────────────────────────────────────
motion {
    reduced     false          // skip animations entirely
    duration-ms 140            // open/close length; clamped to 0..=1000
}

// ── Top-level ─────────────────────────────────────────────────────────
max-results 30               // max total rows in the All view (apps + files + windows)
keep-alive true              // GPU overlay stays in memory (hidden) between uses; false = exits on dismiss